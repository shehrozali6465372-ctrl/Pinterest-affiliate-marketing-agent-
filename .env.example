# Copy to .env locally. Never commit real secrets.
# When set, all operational endpoints require the X-API-Key header.
APP_API_KEY=

DATABASE_URL=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_API_BASE_URL=https://api.pinterest.com/v5
# Pinterest developer app credentials; required for automatic access-token refresh.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Cloudflare image generation (token kept server-side)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Maximum generated image payload size in bytes (default 10 MiB; allowed range 1 KiB–25 MiB).
CLOUDFLARE_IMAGE_MAX_BYTES=10485760

# Temporary workflow retry checkpoints are cleared after 72 hours; idempotency records remain.
WORKFLOW_CHECKPOINT_RETENTION_HOURS=72

# DeepSeek Flash content generation
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Modern Living Hub -> Agent service-to-service credential ingest
# Use the same high-entropy value as PINTEREST_AGENT_INGEST_KEY in Modern Living Hub Render.
PINTEREST_CREDENTIAL_INGEST_KEY=
# Legacy single-key mode. Keep the original value until every legacy ciphertext is re-encrypted.
PINTEREST_TOKEN_ENCRYPTION_KEY=
# Optional JSON key ring for controlled rotation; example shape only, never use these example bytes as real secrets.
# {"legacy":"<base64-32-byte-old-key>","2026-11":"<base64-32-byte-new-key>"}
PINTEREST_TOKEN_ENCRYPTION_KEYS=
# Must match one key ID in PINTEREST_TOKEN_ENCRYPTION_KEYS when the key ring is enabled.
PINTEREST_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=
